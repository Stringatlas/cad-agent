# Copy this file to apps/server/.env (NOT the repository root or apps/web).
# This file is read only by the server executable, independent of cwd.
# Process environment overrides file values. Restart after changing configuration.
# Select exactly one mode: disabled | api-key | chatgpt. No automatic fallback.
SPATIAL_PROVIDER_MODE=chatgpt

# Required only for api-key mode. This uses separately billed OpenAI API usage.
# Server-only secret: never use VITE_* or place in apps/web/.env.
OPENAI_API_KEY=

# Optional absolute path; default ~/.spatial-cad-harness/auth/credentials.json.
# The immediate parent must be owner-only (0700); files are written 0600.
# SPATIAL_AUTH_PATH=/absolute/private/directory/credentials.json

# Fixed loopback callback of the executable server; localhost is NOT equivalent.
# SPATIAL_AUTH_REDIRECT_URI=http://127.0.0.1:3001/auth/callback

# Optional project persistence override (separate from provider credentials).
# SPATIAL_PROJECT_PATH=/absolute/path/project.json
