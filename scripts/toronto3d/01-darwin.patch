index 0fc6b14..e2f156b 100644
--- a/Converter/modules/unsuck/unsuck_platform_specific.cpp
+++ b/Converter/modules/unsuck/unsuck_platform_specific.cpp
@@ -145,6 +145,76 @@ CpuData getCpuData() {
 	return data;
 }
 
+#elif defined(__APPLE__)
+
+#include <mach/mach.h>
+#include <sys/sysctl.h>
+#include <sys/resource.h>
+
+MemoryData getMemoryData() {
+    MemoryData data;
+    uint64_t total = 0;
+    size_t size = sizeof(total);
+    sysctlbyname("hw.memsize", &total, &size, nullptr, 0);
+    data.physical_total = total;
+    data.virtual_total = total;
+    vm_statistics64_data_t vm{};
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    vm_size_t pageSize = 0;
+    host_page_size(mach_host_self(), &pageSize);
+    if (host_statistics64(mach_host_self(), HOST_VM_INFO64,
+            reinterpret_cast<host_info64_t>(&vm), &count) == KERN_SUCCESS) {
+        data.physical_used = total - uint64_t(vm.free_count) * pageSize;
+        data.virtual_used = data.physical_used;
+    }
+    mach_task_basic_info_data_t task{};
+    count = MACH_TASK_BASIC_INFO_COUNT;
+    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO,
+            reinterpret_cast<task_info_t>(&task), &count) == KERN_SUCCESS) {
+        data.virtual_usedByProcess = task.virtual_size;
+        data.physical_usedByProcess = task.resident_size;
+    }
+    static size_t virtualMax = 0, physicalMax = 0;
+    virtualMax = std::max(virtualMax, data.virtual_usedByProcess);
+    physicalMax = std::max(physicalMax, data.physical_usedByProcess);
+    data.virtual_usedByProcess_max = virtualMax;
+    data.physical_usedByProcess_max = physicalMax;
+    return data;
+}
+
+CpuData getCpuData() {
+    CpuData data;
+    data.numProcessors = std::max(1u, std::thread::hardware_concurrency());
+    struct rusage usage{};
+    getrusage(RUSAGE_SELF, &usage);
+    double cpu = usage.ru_utime.tv_sec + usage.ru_utime.tv_usec / 1e6
+               + usage.ru_stime.tv_sec + usage.ru_stime.tv_usec / 1e6;
+    double now = std::chrono::duration<double>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    static double previousCPU = cpu, previousTime = now;
+    if (now > previousTime) {
+        data.usage = 100.0 * (cpu - previousCPU) / (now - previousTime) / data.numProcessors;
+    }
+    previousCPU = cpu;
+    previousTime = now;
+    return data;
+}
+
+void printMemoryReport() {
+    auto data = getMemoryData();
+    cout << "memory usage: virtual: " << formatNumber(double(data.virtual_usedByProcess) / (1ull << 30), 1)
+         << " GB, physical: " << formatNumber(double(data.physical_usedByProcess) / (1ull << 30), 1) << " GB" << endl;
+}
+
+void launchMemoryChecker(int64_t, double checkInterval) {
+    thread([checkInterval]() {
+        while (true) {
+            getMemoryData();
+            std::this_thread::sleep_for(std::chrono::milliseconds(int64_t(checkInterval * 1000)));
+        }
+    }).detach();
+}
+
